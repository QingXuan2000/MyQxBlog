{
  "name": "qxblog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "preview": "node scripts/preview.js",
    "sync": "node scripts/sync.js",
    "format": "prettier --write src scripts package.json .github/workflows/qxblog-build.yml",
    "format:check": "prettier --check src scripts package.json .github/workflows/qxblog-build.yml"
  },
  "dependencies": {
    "hast-util-to-text": "4.0.2",
    "katex": "0.19.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-pretty-code": "0.14.5",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
